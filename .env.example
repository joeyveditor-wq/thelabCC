# The Idea Lab — environment configuration
# Copy to .env.local and fill in to enable real integrations.
# Everything works WITHOUT these set: data falls back to an in-memory store
# and Claude/ingestion run against deterministic local stubs.

# MongoDB connection string. If unset, an in-memory store is used (data resets on restart).
MONGODB_URI=
MONGODB_DB=idea_lab

# Anthropic Claude API. If unset, generation uses a grounded local stub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: YouTube Data API / scraping providers (stubs used if unset)
YOUTUBE_API_KEY=
